<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud Auto Backup goes through LauncherBackupAgent's user-controlled gate. -->
    <cloud-backup>
        <include domain="root" path="." />
    </cloud-backup>
    <!-- A static manifest cannot express the per-user switch for OEM D2D copies.
         Deny direct device transfer rather than silently bypass the user's setting.
         Users can explicitly export/import JSON when migrating devices. -->
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
