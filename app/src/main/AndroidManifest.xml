<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <!-- Required on Android 9+ for a third-party launcher to open the system
         uninstall confirmation UI for another package. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ filters package visibility. This tells the system that we want
         to query apps that expose a normal launcher activity. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Common de-facto intent actions exposed by Android icon packs. -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
    </queries>

    <application
        android:name=".EELauncherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:backupAgent=".LauncherBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/e_e_launcher_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/e_e_launcher_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EeLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">

            <!-- Makes this app selectable as the default Home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Keeps the app visible in normal app lists while developing. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".LauncherNoteWidgetProvider"
            android:exported="true"
            android:label="@string/ui_note_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/launcher_note_widget_info" />
        </receiver>
        <activity
            android:name=".LauncherNoteWidgetEditActivity"
            android:exported="false"
            android:theme="@style/Theme.EeLauncherNoteEditor" />
        <receiver
            android:name=".WidgetHostRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".LauncherAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
